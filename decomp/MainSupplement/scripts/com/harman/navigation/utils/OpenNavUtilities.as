      public function OpenNavUtilities()
      {
         super();
      }
      
      public static function convertEISType(type:String, bNNGType:Boolean = true) : String
      {
         var rtn:String = "<" + type;
         if(bNNGType)
         {
            rtn += "_NNG";
         }
         return rtn + ">";
      }
      
      public static function f_ToEIS(eisTag:String, eisValue:* = null) : String
      {
         if(eisValue == null)
         {
            return eisTag + c_EIS_TOKEN_END;
         }
         return eisTag + toString(eisValue) + c_EIS_TOKEN_END;
      }
      
      public static function f_ParseEisString(eis:String) : Object
      {
         var i:String = null;
         var retval:Object = new Object();
         var workArray:Array = new Array();
         workArray = eis.split("<*>");
         var workTag:String = new String();
         for each(i in workArray)
         {
            if(i != "")
            {
               workTag = i.slice(i.indexOf("<") + 1,i.indexOf(">"));
               if(workTag == c_EIS_ICON_N)
               {
                  if(retval[workTag] == null)
                  {
                     retval[workTag] = new Array();
                  }
                  (retval[workTag] as Array)[(retval[workTag] as Array).length] = i.slice(i.indexOf(">") + 1);
               }
               else if(workTag == c_EIS_TXT_N)
               {
                  if(retval[workTag] == null)
                  {
                     retval[workTag] = new Vector.<String>();
                  }
                  (retval[workTag] as Vector.<String>)[(retval[workTag] as Vector.<String>).length] = i.slice(i.indexOf(">") + 1);
               }
               else
               {
                  retval[workTag] = i.slice(i.indexOf(">") + 1);
               }
            }
         }
         workArray.length = 0;
         workArray = null;
         return retval;
      }
      
      public static function getListType(respEIS:String = "") : String
      {
         if(respEIS == "")
         {
            return "";
         }
         var tempString:String = respEIS.slice(0,respEIS.length - 3);
         var leftBracketIndex:int = tempString.lastIndexOf("<");
         var rightBracketIndex:int = tempString.lastIndexOf(">");
         return tempString.substring(leftBracketIndex + 1,rightBracketIndex);
      }
      
      public static function getValueFromEisPair(eisPair:String) : String
      {
         return eisPair.substring(eisPair.indexOf(">") + 1,eisPair.indexOf("<*>"));
      }
      
      public static function getTypeFromEisPair(eisPair:String, bNoBracket:Boolean = true) : String
      {
         if(bNoBracket)
         {
            return eisPair.substring(eisPair.indexOf("<") + 1,eisPair.indexOf(">"));
         }
         return eisPair.substring(eisPair.indexOf("<"),eisPair.indexOf(">") + 1);
      }
      
      public static function getLastTypeFromEisString(eisString:String) : String
      {
         var ret:String = null;
         var begin:int = eisString.lastIndexOf("<*><") + 4;
         ret = eisString.substr(begin,eisString.length - begin);
         return ret.substr(0,ret.indexOf(">"));
      }
      
      public static function getLastValueFromEisString(eisString:String) : String
      {
         var ret:String = null;
         ret = eisString.substring(0,eisString.lastIndexOf("<*>"));
         return ret.substring(ret.lastIndexOf(">") + 1,ret.length);
      }
      
      public static function getValueOfType(eisString:String, eisType:String) : String
      {
         var erg:String = "";
         if(eisString.indexOf(eisType) == -1)
         {
            return erg;
         }
         erg = eisString.substr(eisString.indexOf(eisType) + eisType.length,eisString.length);
         return erg.substr(0,erg.indexOf("<*>"));
      }
      
      public static function f_GetStreetFromEIS(str:String) : String
      {
         var tempEISarray:String = str.split(c_EIS_STR)[1];
         return tempEISarray.split(c_EIS_TOKEN_END)[0] || "";
      }
      
      public static function f_InsertIntoEISString(eis:String, tag:String, value:*) : String
      {
         return eis + f_ToEIS(tag,value);
      }
      
      private static function toString(value:*) : String
      {
         var retval:String = new String();
         if(value is int || value is Number)
         {
            retval = String(value);
         }
         else if(value is String)
         {
            retval = value;
         }
         else
         {
            retval = "";
         }
         return retval;
      }
      
      public static function f_CheckString(test:String) : String
      {
         return test == null ? "" : test;
      }
      
      public static function f_ReverseGeoOrder(geo:String) : String
      {
         var temp:Array = geo.split(" ");
         return temp[1] + " " + temp[0];
      }
      
      public static function getDatabaseID(eisString:String) : uint
      {
         var temp:Object = OpenNavUtilities.f_ParseEisString(String(eisString));
         var tempString:String = temp[OpenNavUtilities.c_EIS_CTR_NNG_N];
         if(tempString == null || tempString == "")
         {
            tempString = temp[OpenNavUtilities.c_EIS_CTY_NNG_N];
            if(tempString == null || tempString == "")
            {
               tempString = temp[OpenNavUtilities.c_EIS_ZIP_NNG_N];
            }
         }
         if(tempString == null || tempString == "")
         {
            return 0;
         }
         return uint(tempString.substr(0,tempString.indexOf("|")));
      }
