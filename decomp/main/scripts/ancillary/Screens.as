      public static function get POPUP_SPELLER_CHINA() : String
      {
         if(Framework.resolution == Framework.RES_800_480)
         {
            return "SpellerPinYinScreen.swf";
         }
         return "SpellerScreenChina.swf";
      }
      
      public static function get POPUP_ANTITHEFT() : String
