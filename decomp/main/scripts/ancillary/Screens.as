      public static function setPhoneScreenOnDeviceProjection(isDeviceProjectionActive:Boolean) : void
      {
         if(isDeviceProjectionActive)
         {
            MAIN_PHONE = "DeviceProjection.swf";
         }
         else
         {
            MAIN_PHONE = "PhoneMainScreen.swf";
         }
      }
      
      public function getDomain(branch:String) : String
      {
         var screenObj:Object = screenMap[branch];
         if(screenObj != null)
         {
            return screenObj.domain;
         }
         return DOMAIN_NONE;
      }
      
      public function modifyHistory(branch:String) : void
      {
         var _exitBranch:String = Framework.structure.returnExitBranch();
         var _domain:String = this.getDomain(_exitBranch);
         if(_domain == DOMAIN_TUNER || _domain == DOMAIN_MEDIA)
         {
            if(branch != "" && _exitBranch != branch)
            {
               Framework.structure.findAndReplace(_exitBranch,branch,null,true);
            }
         }
      }
      
      public function isNavDomain(branch:String) : Boolean
      {
         return this.getDomain(branch) == DOMAIN_NAVIGATION;
      }
      
